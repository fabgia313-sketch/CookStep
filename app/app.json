{
  "expo": {
    "name": "CookStep",
    "slug": "cookstep",
    "version": "1.0.0",
    "scheme": "cookstep",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "platforms": ["android"],
    "android": {
      "package": "com.cookstep.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FF6B35"
      },
      "edgeToEdgeLayoutEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "67796cb8-beaf-49c7-8f0b-bdf3ccbd0559"
      }
    }
  }
}
